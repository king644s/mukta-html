RewriteEngine On
RewriteBase /

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.muktaexports\.com$ [NC]
RewriteRule ^(.*)$ https://muktaexports.com/$1 [L,R=301]

# Block direct access to html-backup folder
RewriteRule ^html-backup/ - [F,L]

# Block direct access to app directory (includes all core, controllers, models, config, views, logs)
RewriteRule ^app/ - [F,L]

# Explicitly block access to logs folder from any path
RewriteRule ^(.*/)?logs/ - [F,L]
RewriteRule ^(.*/)?app/logs/ - [F,L]

# Explicitly block all PHP files in app directory (core, controllers, models, config, views)
RewriteRule ^app/(core|controllers|models|config|views)/.*\.php$ - [F,L]

# Block PHPMailer directory if it exists
RewriteRule ^PHPMailer-master/ - [F,L]

# Block router.php from direct access (it should only be used internally)
RewriteRule ^router\.php$ - [F,L]

# Redirect .html to clean URLs (301 permanent redirect for SEO)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Redirect index.html to root
RewriteRule ^index\.html$ / [R=301,L]

# Route all requests to index.php except existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Disable ETags for consistent cache behavior
FileETag None
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2 application/font-woff application/font-woff2 application/vnd.ms-fontobject
    <IfModule mod_setenvif.c>
        SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico|zip|gz|bz2|rar|7z|mp4|webm|woff2?)$ no-gzip dont-vary
    </IfModule>
    Header append Vary Accept-Encoding env=REDIRECT_accept_encoding
</IfModule>

# Browser caching (Expires + Cache-Control)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/xml "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Versioned CSS/JS — safe to cache aggressively (filename changes on update)
    <FilesMatch "\.v[0-9]+\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Other static CSS/JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>

    # Images, icons, fonts
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # PDFs
    <FilesMatch "\.pdf$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # SEO files
    <FilesMatch "^(sitemap\.xml|robots\.txt)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=43200"
    </FilesMatch>
</IfModule>

# Protect sensitive files (router.php, .env, composer files, etc.)
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.(json|lock)|package(-lock)?\.json|router\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>
